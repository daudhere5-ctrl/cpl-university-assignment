//56. Calculate restaurant bill using switch.
#include <iostream>
using namespace std;
int main()
{
    int choice, quantity;
    int price;
    cout<<"1 = Pizza (Rs. 800)"<<endl;
    cout<<"2 = Burger (Rs. 450)"<<endl;
    cout<<"3 = Sandwich (Rs. 300)"<<endl;
    cout<<"Select food: ";
    cin>>choice;
    cout<<"Enter quantity: ";
    cin>>quantity;

    switch(choice)
    {
        case 1:
            price=800;
            cout<<"Total = Rs. "<<price*quantity;
            break;
        case 2:
            price=450;
            cout<<"Total = Rs. "<<price*quantity;
            break;
        case 3:
            price=300;
            cout<<"Total = Rs. "<<price*quantity;
            break;
        default: cout<<"Invalid choice";
    }

    return 0;
}