//58. Create a banking menu with deposit and withdrawal.
#include <iostream>
using namespace std;
int main()
{
    int choice;
    float balance=10000, amount;
    cout<<"1 = Check balance"<<endl;
    cout<<"2 = Deposit"<<endl;
    cout<<"3 = Withdraw"<<endl;
    cout<<"Select option: ";
    cin>>choice;

    switch(choice)
    {
        case 1:
            cout<<"Balance = Rs. "<<balance;
            break;
        case 2:
            cout<<"Enter deposit amount: ";
            cin>>amount;
            if (amount>0)
            {
                balance=balance+amount;
                cout<<"New balance = Rs. "<<balance;
            }
            else {cout<<"Deposit must be positive";}
            break;
        case 3:
            cout<<"Enter withdrawal amount: ";
            cin>>amount;
            if (amount<=0)
            {
                cout<<"Withdrawal must be positive";
            }
            else if (amount>balance)
            {
                cout<<"Insufficient balance";
            }
            else
            {
                balance=balance-amount;
                cout<<"New balance = Rs. "<<balance;
            }
            break;
        default: cout<<"Invalid choice";
    }

    return 0;
}