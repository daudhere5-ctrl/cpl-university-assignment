//50. Display grade description using switch.
#include <iostream>
using namespace std;
int main()
{
    char grade;
    cout<<"Enter grade (A, B, C): ";
    cin>>grade;

    switch(grade)
    {
        case 'A':
        case 'a': cout<<"Excellent"; break;
        case 'B':
        case 'b': cout<<"Good"; break;
        case 'C':
        case 'c': cout<<"Average"; break;
        default: cout<<"Invalid grade";
    }

    return 0;
}