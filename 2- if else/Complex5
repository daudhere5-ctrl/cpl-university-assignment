//30. Check eligibility using average marks.
#include <iostream>
using namespace std;
int main()
{
    int a, b, c;
    float average;
    cout<<"Enter three subject marks: ";
    cin>>a>>b>>c;

    average=(a+b+c)/3.0;

    if (average>=60)
    {
        cout<<"Eligible";
    }
    else {cout<<"Not eligible";}

    return 0;
}