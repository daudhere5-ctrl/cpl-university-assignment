
// 20. Input two numbers and display the greater number, or state that they are equal.
#include <iostream>
using namespace std;

int main()
{
    int number1, number2;

    cout << "Enter 1st number: ";
    cin >> number1;

    cout << "Enter 2nd number: ";
    cin >> number2;

    if (number1 > number2)
    {
        cout << "Number 1 is greater: " << number1;
    }
    else if (number2 > number1)
    {
        cout << "Number 2 is greater: " << number2;
    }
    else
    {
        cout << "Numbers are equal!";
    }

    return 0;
}
