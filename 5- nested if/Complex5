//75. Check marks and attendance for examination eligibility.
#include <iostream>
using namespace std;
int main()
{
    float marks, attendance;
    cout<<"Enter marks: ";
    cin>>marks;

    if (marks>=50)
    {
        cout<<"Enter attendance percentage: ";
        cin>>attendance;
        if (attendance>=75)
        {
            cout<<"Eligible for examination";
        }
        else {cout<<"Attendance is below 75%";}
    }
    else {cout<<"Marks are below 50";}

    return 0;
}