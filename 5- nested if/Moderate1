//66. Check age and citizenship for voting.
#include <iostream>
using namespace std;
int main()
{
    int age, citizen;
    cout<<"Enter age: ";
    cin>>age;

    if (age>=18)
    {
        cout<<"Are you a citizen? (1=yes, 0=no): ";
        cin>>citizen;
        if (citizen==1)
        {
            cout<<"Eligible to vote";
        }
        else {cout<<"Not a citizen";}
    }
    else {cout<<"Age requirement not met";}

    return 0;
}