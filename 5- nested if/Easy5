//65. Check whether two numbers are positive.
#include <iostream>
using namespace std;
int main()
{
    int a, b;
    cout<<"Enter two numbers: ";
    cin>>a>>b;

    if (a>0)
    {
        if (b>0)
        {
            cout<<"Both numbers are positive";
        }
        else {cout<<"Second number is not positive";}
    }
    else {cout<<"First number is not positive";}

    return 0;
}