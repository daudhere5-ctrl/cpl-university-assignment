//72. Check and classify a triangle using its sides.
#include <iostream>
using namespace std;
int main()
{
    int a, b, c;
    cout<<"Enter three sides: ";
    cin>>a>>b>>c;

    if (a>0 && b>0 && c>0)
    {
        if (a+b>c && a+c>b && b+c>a)
        {
            if (a==b && b==c)
            {
                cout<<"Equilateral triangle";
            }
            else if (a==b || a==c || b==c)
            {
                cout<<"Isosceles triangle";
            }
            else {cout<<"Scalene triangle";}
        }
        else {cout<<"Invalid triangle";}
    }
    else {cout<<"Sides must be positive";}

    return 0;
}