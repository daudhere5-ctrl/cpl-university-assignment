//68. Check range and divisibility by 3 and 5.
#include <iostream>
using namespace std;
int main()
{
    int number;
    cout<<"Enter a number: ";
    cin>>number;

    if (number>=1 && number<=100)
    {
        if (number%3==0 && number%5==0)
        {
            cout<<"Divisible by both 3 and 5";
        }
        else {cout<<"Not divisible by both 3 and 5";}
    }
    else {cout<<"Number is outside the range";}

    return 0;
}