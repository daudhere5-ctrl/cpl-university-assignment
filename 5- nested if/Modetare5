//70. Check age and driving licence.
#include <iostream>
using namespace std;
int main()
{
    int age, licence;
    cout<<"Enter your age: ";
    cin>>age;

    if (age>=18)
    {
        cout<<"Do you have a driving licence? (1=yes, 0=no): ";
        cin>>licence;
        if (licence==1)
        {
            cout<<"Allowed to drive";
        }
        else {cout<<"Driving licence required";}
    }
    else {cout<<"Not old enough to drive";}

    return 0;
}