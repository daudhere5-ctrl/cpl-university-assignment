//39. Calculate electricity bill using progressive rates.
#include <iostream>
using namespace std;
int main()
{
    int units;
    float bill;
    cout<<"Enter electricity units: ";
    cin>>units;

    if (units<=100)
    {
        bill=units*10;
    }
    else if (units<=200)
    {
        bill=100*10+(units-100)*12;
    }
    else
    {
        bill=100*10+100*12+(units-200)*15;
    }

    cout<<"Electricity bill = Rs. "<<bill;
    return 0;
}